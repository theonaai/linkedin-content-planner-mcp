{
  "name": "linkedin-planner",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:server": "pnpm --filter @linkedin-planner/server dev",
    "dev:web": "pnpm --filter @linkedin-planner/web dev",
    "db:generate": "pnpm --filter @linkedin-planner/db generate",
    "db:migrate": "pnpm --filter @linkedin-planner/db migrate",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3"
  }
}
