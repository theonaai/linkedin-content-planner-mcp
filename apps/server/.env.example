PORT=3210
DATABASE_URL=postgres://linkedin_planner:linkedin_planner@localhost:5432/linkedin_planner_dev
ATTACHMENTS_DIR=./data/attachments
# Signs the short-lived attachment upload tickets handed out by prepare_attachment_upload.
# Optional: unset means a fresh random key per process, which is fine for a single instance.
# Required once the server runs behind more than one process, or a ticket minted by one won't
# verify on another.
# ATTACHMENT_UPLOAD_SECRET=
